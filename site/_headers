# Revalidateér de filer, som ofte ændres, så nye versioner vises straks.
/ 
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: no-store, max-age=0

/js/*
  Cache-Control: no-store, max-age=0

/data/*
  Cache-Control: no-cache, must-revalidate

# Billeder ændres sjældent og må gerne ligge kortvarigt i browserens cache.
/images/*
  Cache-Control: public, max-age=3600

# Testversionen og forhåndsvisninger må ikke findes af søgemaskiner.
https://test.teb-tistrup.dk/*
  X-Robots-Tag: noindex, nofollow

https://:version.teb-tistrup.pages.dev/*
  X-Robots-Tag: noindex, nofollow
