<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dk.teb.facebook-composio</string>
  <key>ProgramArguments</key><array>
    <string>__ABSOLUTE_NODE_PATH__</string>
    <string>__ABSOLUTE_REPOSITORY_PATH__/scripts/facebook-composio.mjs</string>
    <string>pull</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__ABSOLUTE_PRIVATE_LOG_DIRECTORY__/facebook-composio.log</string>
  <key>StandardErrorPath</key><string>__ABSOLUTE_PRIVATE_LOG_DIRECTORY__/facebook-composio-error.log</string>
</dict></plist>
