{
  "name": "teb-kalender",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy",
    "test:pdf": "node scripts/pdf-check.mjs",
    "test:integration": "node scripts/integration-check.mjs",
    "test:browser": "node ../scripts/portal-browser-check.mjs",
    "test:cloudflare": "npm run build && node scripts/cloudflare-check.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "htmlparser2": "10.0.0",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta",
    "playwright": "1.64.1",
    "wrangler": "4.151.1"
  }
}
