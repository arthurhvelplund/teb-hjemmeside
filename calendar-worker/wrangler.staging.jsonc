// Testversion på test.teb-tistrup.dk. Egen database og eget lager, adskilt fra produktion.
// EDITOR_EMAIL og TEB_ADMIN_EMAILS sættes som secrets, så adresserne ikke står i det offentlige repo.
{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "teb-kalender-staging-api",
 "main": "src/worker.mjs",
 "compatibility_date": "2026-09-04",
 "compatibility_flags": ["nodejs_compat"],
 "workers_dev": false,
 "preview_urls": false,
 "routes": [{"pattern":"test.teb-tistrup.dk","custom_domain":true}],
 "assets": {"directory":"assets","binding":"ASSETS","run_worker_first":true},
 "d1_databases": [{"binding":"DB","database_name":"teb-kalender-staging","database_id":"b3e9b7c8-0283-4d20-b543-3c77bc0c1c35","migrations_dir":"migrations"}],
 "r2_buckets": [{"binding":"PDFS","bucket_name":"teb-kalender-staging-pdfs"}],
 "send_email": [{"name":"TEB_EMAIL"}],
 "vars": {"PUBLIC_ORIGIN":"https://test.teb-tistrup.dk","SITE_ORIGIN":"https://staging.teb-tistrup.pages.dev","LOCAL_PREVIEW":"false","EMAIL_FROM":"kalender@teb-tistrup.dk","REPLY_TO":"tistrup.kalender@gmail.com"},
 "triggers": {"crons":["*/10 * * * *"]}
}
