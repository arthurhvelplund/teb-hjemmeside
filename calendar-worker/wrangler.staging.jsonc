// Testversion på test.teb-tistrup.dk. Egen database og eget lager, adskilt fra produktion.
// Mail sendes kun til de aftalte testmodtagere.
{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "teb-kalender-staging-api",
 "main": "src/worker.mjs",
 "compatibility_date": "2026-09-04",
 "compatibility_flags": ["nodejs_compat"],
 "workers_dev": false,
 "preview_urls": false,
 "routes": [{"pattern":"test.teb-tistrup.dk/api/kalender/*","zone_name":"teb-tistrup.dk"}],
 "assets": {"directory":"assets","binding":"ASSETS","run_worker_first":true},
 "d1_databases": [{"binding":"DB","database_name":"teb-kalender-staging","database_id":"b3e9b7c8-0283-4d20-b543-3c77bc0c1c35","migrations_dir":"migrations"}],
 "r2_buckets": [{"binding":"PDFS","bucket_name":"teb-kalender-staging-pdfs"}],
 "send_email": [{"name":"TEB_EMAIL","allowed_destination_addresses":["afhvelplund@gmail.com","<admin-2>","tistrup.kalender@gmail.com","<bødkerhuset-kontakt>"]}],
 "vars": {"PUBLIC_ORIGIN":"https://test.teb-tistrup.dk","LOCAL_PREVIEW":"false","EDITOR_EMAIL":"tistrup.kalender@gmail.com,afhvelplund@gmail.com","EMAIL_FROM":"kalender@teb-tistrup.dk","REPLY_TO":"tistrup.kalender@gmail.com","TEB_ADMIN_EMAILS":"afhvelplund@gmail.com,<admin-2>"},
 "triggers": {"crons":["*/10 * * * *"]}
}
