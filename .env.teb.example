# Kopiér til .env.teb.local og udfyld med token fra Arthurs Cloudflare-konto.
# Disse værdier bruges KUN i dette projekt og overskriver ikke din globale wrangler-login.
#
# Opret token: https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Workers" + tilføj Zone DNS Edit for teb-tistrup.dk
# Eller custom token med mindst:
#   - Account → Cloudflare Pages → Edit
#   - Account → Account Settings → Read
#   - Zone → DNS → Edit  (for teb-tistrup.dk)
#
# Brug i shell (inden wrangler/agent-arbejde i denne mappe):
#   set -a && source .env.teb.local && set +a
#   wrangler whoami   # skal vise Arthurs konto, ikke Business and Fitness

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
